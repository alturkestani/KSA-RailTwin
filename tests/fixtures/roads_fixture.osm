     w3 secondary oneway 1->4; w4 residential 3-6; w5 trunk 2-5 access=private (excluded);
     w6 tertiary island 7-8. -->
<osm version="0.6" generator="fixture">
  <node id="1" version="1" lat="22.05" lon="40.05"/>
  <node id="2" version="1" lat="22.05" lon="40.15"/>
